{
  "name": "focusfence",
  "version": "1.0.0",
  "description": "FocusFence — freemium Chrome extension that blocks distracting websites",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test tests/core.spec.mjs",
    "icons": "node scripts/icons.mjs",
    "vendor": "cp node_modules/extpay/dist/ExtPay.js src/vendor/ExtPay.js",
    "build": "node scripts/build.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "docs": "node scripts/docs.mjs",
    "i18n": "node scripts/i18n/build.mjs",
    "i18n:check": "node scripts/i18n/build.mjs --check",
    "screenshots:all": "node scripts/screenshots.mjs && node scripts/screenshots.mjs --lang fr && node scripts/screenshots.mjs --lang es && node scripts/screenshots.mjs --lang de",
    "cws:check": "node scripts/build.mjs >/dev/null && node scripts/cws-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "extpay": "^3.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "playwright": "^1.65.0"
  },
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexarion434/focusfence"
  }
}
